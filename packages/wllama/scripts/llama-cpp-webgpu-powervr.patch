+// texture rows holding m x k dequantized weights (8 per texel)
+static uint32_t ggml_webgpu_pvr_dequant_rows(uint64_t m, uint64_t k) {
+    return (uint32_t) CEIL_DIV(m * (k / 8), WEBGPU_MUL_MAT_PVR_TEX_W);
