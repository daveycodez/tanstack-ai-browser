diff --git a/common/ngram-map.cpp b/common/ngram-map.cpp
index d1cb451..b7b0c06 100644
--- a/common/ngram-map.cpp
+++ b/common/ngram-map.cpp
@@ -54,6 +54,35 @@ llama_tokens common_ngram_simple_draft(
     //
     const size_t cur_len = tokens.size();
 
+    if (config.size_ngram_min > 0 && config.size_ngram_min < config.size_ngram) {
+        // the longest n-gram (size_ngram down to size_ngram_min) that ends with the sampled token
+        // and occurred before: draft the tokens that followed its most recent occurrence, at most
+        // 2^(n-1) of them (shorter matches predict less, and checking a token costs time)
+        const size_t n_tot = cur_len + 1; // the history and the sampled token
+        auto at = [&](size_t i) { return i < cur_len ? tokens[i] : sampled; };
+        llama_tokens draft;
+        for (size_t n = config.size_ngram; n >= config.size_ngram_min; --n) {
+            if (n_tot <= n) {
+                continue;
+            }
+            for (size_t j = n_tot - n; j-- > 0;) {
+                size_t k = 0;
+                while (k < n && at(j + k) == at(n_tot - n + k)) {
+                    k++;
+                }
+                if (k == n) {
+                    const size_t len = std::min((size_t) config.size_mgram, (size_t) 1 << std::min<size_t>(n - 1, 16));
+                    const size_t end = std::min(j + n + len, n_tot);
+                    for (size_t i = j + n; i < end; i++) {
+                        draft.push_back(at(i));
+                    }
+                    return draft;
+                }
+            }
+        }
+        return draft;
+    }
+
     const size_t n_draft_min = config.size_ngram; // size of n-gram to lookup in token history
     const size_t n_draft_max = config.size_mgram; // the m-gram following the found n-gram is used for draft
 
