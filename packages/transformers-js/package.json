{
  "name": "@tanstack-ai-browser/transformers-js",
  "version": "0.1.0",
  "description": "TanStack AI adapter for Transformers.js models running in the browser on WebGPU",
  "license": "MIT",
  "author": "daveycodez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daveycodez/tanstack-ai-browser.git",
    "directory": "packages/transformers-js"
  },
  "homepage": "https://github.com/daveycodez/tanstack-ai-browser/tree/main/packages/transformers-js#readme",
  "bugs": "https://github.com/daveycodez/tanstack-ai-browser/issues",
  "keywords": [
    "tanstack-ai",
    "tanstack",
    "ai",
    "llm",
    "transformers.js",
    "webgpu",
    "onnx",
    "browser",
    "local-ai"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@tanstack-ai-browser/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./model-meta": {
      "@tanstack-ai-browser/source": "./src/model-meta.ts",
      "types": "./dist/model-meta.d.ts",
      "import": "./dist/model-meta.js",
      "default": "./dist/model-meta.js"
    }
  },
  "files": [
    "src",
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "test": "node scripts/test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "transformers-js"
  },
  "peerDependencies": {
    "@tanstack/ai": "^1.0.0"
  },
  "devDependencies": {
    "@tanstack/ai": "1.2.0",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "llguidance": "0.2.1"
  }
}
