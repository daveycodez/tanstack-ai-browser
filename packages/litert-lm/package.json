{
  "name": "@tanstack-ai-browser/litert-lm",
  "version": "0.3.2",
  "description": "TanStack AI adapter for LiteRT-LM, Google's on-device LLM runtime, in the browser on WebGPU: Gemma 4 and other .litertlm models, with tools, thinking and stored downloads",
  "license": "MIT",
  "author": "daveycodez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daveycodez/tanstack-ai-browser.git",
    "directory": "packages/litert-lm"
  },
  "homepage": "https://github.com/daveycodez/tanstack-ai-browser/tree/main/packages/litert-lm#readme",
  "bugs": "https://github.com/daveycodez/tanstack-ai-browser/issues",
  "keywords": [
    "tanstack-ai",
    "tanstack",
    "ai",
    "llm",
    "litert-lm",
    "litert",
    "gemma",
    "webgpu",
    "browser",
    "on-device",
    "local-ai"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@tanstack-ai-browser/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "src",
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "litert-lm"
  },
  "scripts": {
    "test": "node --import @swc-node/register/esm-register --test \"src/**/*.test.ts\""
  },
  "peerDependencies": {
    "@tanstack/ai": "^1.2.0"
  },
  "dependencies": {
    "@litert-lm/core": "0.19.0"
  },
  "devDependencies": {
    "@tanstack/ai": "1.4.0"
  }
}
