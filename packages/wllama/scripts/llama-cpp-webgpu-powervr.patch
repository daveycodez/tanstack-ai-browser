+#else
+        dst[params.offset_dst + i] = s33;
+#endif
+    }
+    if (r < params.m && c + 4u * LANES < params.n) {
+        let i = (c + 4u * LANES) * params.m + r;
+#ifdef GLU
+        dst[params.offset_dst + i] = out(s04, i);
