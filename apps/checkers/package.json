{
  "name": "@tanstack-ai-browser/checkers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3002",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview --port 3002",
    "deploy": "wrangler deploy",
    "deploy-dry-run": "wrangler deploy --dry-run",
    "test": "node --experimental-strip-types --test src/lib/checkers.test.ts"
  },
  "dependencies": {
    "@tanstack-ai-browser/prompt-api": "workspace:*",
    "@tanstack-ai-browser/webgl": "workspace:*",
    "@tanstack/ai": "1.0.0",
    "@tanstack/react-db": "1.0.0-rc.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "nx": {
    "name": "checkers",
    "tags": [
      "scope:web",
      "type:app"
    ],
    "targets": {
      "build": {
        "cache": true,
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/.wrangler/deploy"
        ]
      },
      "generate-routes": {
        "cache": true,
        "outputs": [
          "{projectRoot}/src/routeTree.gen.ts"
        ]
      },
      "deploy": {
        "dependsOn": [
          "build"
        ]
      },
      "deploy-dry-run": {
        "dependsOn": [
          "build"
        ]
      },
      "typecheck": {
        "command": "tsc --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "generate-routes"
        ],
        "cache": true,
        "inputs": [
          "default",
          "^production",
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ]
      },
      "test": {
        "cache": true
      }
    }
  }
}
