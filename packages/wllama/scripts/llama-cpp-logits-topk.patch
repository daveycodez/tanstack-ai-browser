+// whether the context's top-k logits can stand in for all of them with this chain (see common_sampler::topk_k)
+static void common_sampler_topk_init(common_sampler * gsmpl, const llama_vocab * vocab) {
+    const auto & p = gsmpl->params;
+    gsmpl->topk_k   = 0;
+    gsmpl->topk_idx = -1;
+    // (a grammar checks the token the chain samples, and a rejected one is redrawn from all the logits,
+    // read back from the device then; a grammar applied first, and the reasoning budget while it forces
+    // tokens, take all the logits: see common_sampler_sample)
+    if (p.mirostat != 0 || p.n_probs > 0 || !(p.penalty_repeat >= 1.0f) || !(p.penalty_freq >= 0.0f) ||
+        !(p.penalty_present >= 0.0f)) {
+        return;
+    }
+    for (const auto & lb : p.logit_bias) {
+        if (!(lb.bias <= 0.0f)) {
+            return;
+        }
+    }
+    // the logit-bias sampler adds every bias of a token to the full logits but only the first to a few
+    // candidates: a token biased twice (by the user, or also as a suppressed token) needs them all
+    {
+        std::vector<llama_token> biased;
+        for (const auto & lb : p.logit_bias) {
+            biased.push_back(lb.token);
+        }
+        int32_t             n_suppress = 0;
+        const llama_token * suppress   = llama_vocab_get_suppress_tokens(vocab, &n_suppress);
+        for (int32_t i = 0; i < n_suppress; ++i) {
+            biased.push_back(suppress[i]);
+        }
+        std::sort(biased.begin(), biased.end());
+        if (std::adjacent_find(biased.begin(), biased.end()) != biased.end()) {
+            return;
+        }
+    }
+    const int n = llama_sampler_chain_n(gsmpl->chain);
+    for (int i = 0; i < n; i++) {
+        const char * name = llama_sampler_name(llama_sampler_chain_get(gsmpl->chain, i));
+        if (strcmp(name, "top-k") == 0) {
+            if (p.top_k > 0) {
+                gsmpl->topk_k   = p.top_k;
+                gsmpl->topk_idx = i;
+            }
+            return;
+        }
+        // before top-k: only samplers that lower some logits, or do nothing ("?" names)
+        if (strcmp(name, "penalties") != 0 && strcmp(name, "logit-bias") != 0 && name[0] != '?') {
+            return;
+        }
+    }
+}
