+  // The GPU's buffer type for the token embedding of the model at path, when
+  // its output head is the same tensor (tied: no output.weight), or null. The
+  // loader keeps the token embedding on the CPU, and a tied output head on the
+  // GPU, so the vocabulary table is otherwise held twice; on the GPU too, the
+  // two share one tensor. Only where the GPU looks rows up in it (GET_ROWS),
+  // and not on devices whose tensors are only set whole
+  // (ggml_backend_dev_set_tensor_whole: WebGPU on PowerVR, which repacks
+  // Q4_K and Q6_K tensors so that only its matrix products read them).
+  static ggml_backend_buffer_type_t token_embd_gpu_buft(const std::string &path)
+  {
+    ggml_backend_dev_t gpu = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+    if (gpu == nullptr)
+      return nullptr;
+    auto *set_tensor_whole = (bool (*)(ggml_backend_dev_t))ggml_backend_reg_get_proc_address(
+        ggml_backend_dev_backend_reg(gpu), "ggml_backend_dev_set_tensor_whole");
+    if (set_tensor_whole && set_tensor_whole(gpu))
+      return nullptr;
+    ggml_context *meta = nullptr;
+    gguf_init_params gguf_params = {/* .no_alloc = */ true, /* .ctx = */ &meta};
+    gguf_context *gguf = gguf_init_from_file(path.c_str(), gguf_params);
+    if (gguf == nullptr)
+      return nullptr;
+    ggml_backend_buffer_type_t buft = nullptr;
+    ggml_tensor *embd = ggml_get_tensor(meta, "token_embd.weight");
+    if (embd != nullptr && gguf_find_tensor(gguf, "output.weight") < 0)
+    {
+      ggml_init_params op_params = {/* .mem_size = */ 4 * ggml_tensor_overhead(), /* .mem_buffer = */ nullptr,
+                                    /* .no_alloc = */ true};
+      ggml_context *op_ctx = ggml_init(op_params);
+      ggml_tensor *rows = ggml_new_tensor_1d(op_ctx, GGML_TYPE_I32, 1);
+      if (ggml_backend_dev_supports_op(gpu, ggml_get_rows(op_ctx, embd, rows)))
+        buft = ggml_backend_dev_buffer_type(gpu);
+      ggml_free(op_ctx);
+    }
+    ggml_free(meta);
+    gguf_free(gguf);
+    return buft;
+  }
