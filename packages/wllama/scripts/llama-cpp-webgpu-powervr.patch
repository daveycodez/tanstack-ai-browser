+
+static uint32_t ggml_webgpu_pvr_src0_stride(const ggml_tensor * src0) {
+    return ggml_webgpu_pvr_is_repacked(src0) ? (uint32_t) src0->ne[1] : (uint32_t) (src0->nb[1] / ggml_type_size(src0->type));
