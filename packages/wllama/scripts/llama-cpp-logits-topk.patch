+void llama_context::set_logits_topk(int32_t k) {
+    // only where a GPU computes the logits: on the CPU, reading them all back costs nothing and finding
+    // the top k in the graph costs more than the sampler's own pass
+    ggml_backend_dev_t dev = model.dev_output();
+    if (dev == nullptr || ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+        k = 0;
+    }
+    // the next graph is built with (or without) the top-k nodes; the scheduler grows its buffers if needed
+    cparams.logits_topk = (uint32_t) std::max(0, k);
+}
