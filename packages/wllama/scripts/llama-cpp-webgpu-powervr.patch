+    if (!buf || buf_size < size) {
+        buf_size = std::max<size_t>(size, 64 * 1024);
+        ggml_webgpu_create_buffer(ctx->global_ctx->device, buf, buf_size, wgpu::BufferUsage::Storage, label);
