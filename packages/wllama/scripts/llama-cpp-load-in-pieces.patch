+
+// Whether tensors on this device should only be set whole: on PowerVR
+// (adapter vendor "img-tec"), Q4_K and Q6_K tensors are repacked as they are
+// uploaded, but only when set whole, so the model loader stages each tensor
+// whole there rather than in pieces, and keeps the token embedding off it.
+// ("ggml_backend_dev_set_tensor_whole", see llama_model_loader::load_all_data.)
+static bool ggml_backend_webgpu_dev_set_tensor_whole(ggml_backend_dev_t dev) {
+    auto * ctx = static_cast<ggml_backend_webgpu_device_context *>(dev->context);
+    return ctx->webgpu_global_ctx && ggml_webgpu_is_pvr(ctx->webgpu_global_ctx);
+}
+
+static void * ggml_backend_webgpu_reg_get_proc_address(ggml_backend_reg_t reg, const char * name) {
+    GGML_UNUSED(reg);
+    if (strcmp(name, "ggml_backend_dev_set_tensor_whole") == 0) {
+        return (void *) ggml_backend_webgpu_dev_set_tensor_whole;
+    }
+    return nullptr;
 }
 
