{
  "name": "@tanstack-ai-browser/lofi-agent",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/chat/*.test.ts",
    "deploy": "wrangler deploy",
    "build-cities": "node scripts/build-cities.mjs"
  },
  "dependencies": {
    "@gravity-ui/icons": "2.23.1",
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack-ai-browser/apfel": "workspace:*",
    "@tanstack-ai-browser/prompt-api": "workspace:*",
    "@tanstack-ai-browser/transformers-js": "workspace:*",
    "@tanstack-ai-browser/webgllm": "workspace:*",
    "@tanstack-ai-browser/wllama": "workspace:*",
    "@tanstack/ai": "1.2.0",
    "@tanstack/ai-client": "1.1.0",
    "@tanstack/ai-mcp": "1.1.0",
    "@tanstack/ai-react": "1.0.2",
    "@tanstack/highlight": "1.2.11",
    "@tanstack/markdown": "1.2.0",
    "@tanstack/react-db": "1.0.0-rc.1.4",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "katex": "^0.19.1",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-textarea-autosize": "^8.5.9",
    "tailwindcss": "^4.3.5",
    "tanstack-markdown-math": "1.0.0",
    "use-stick-to-bottom": "^1.1.6",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/react-ai-devtools": "1.0.1",
    "@tanstack/router-cli": "^1.168.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "0.28.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "nx": {
    "name": "lofi-agent",
    "tags": [
      "scope:web",
      "type:app"
    ],
    "targets": {
      "deploy": {
        "dependsOn": [
          "build"
        ]
      },
      "typecheck": {
        "command": "tsc --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "default",
          "^production",
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ]
      }
    }
  }
}
