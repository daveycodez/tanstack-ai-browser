{
  "name": "@tanstack-ai-browser/afm",
  "version": "0.1.0",
  "description": "TanStack AI adapter for Apple's on-device Foundation Model (AFM), through Apple's framework itself, with native tool calling: a Capacitor plugin for iOS and a Node-API addon for Electron on macOS",
  "license": "MIT",
  "author": "daveycodez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daveycodez/tanstack-ai-browser.git",
    "directory": "packages/afm"
  },
  "homepage": "https://github.com/daveycodez/tanstack-ai-browser/tree/main/packages/afm#readme",
  "bugs": "https://github.com/daveycodez/tanstack-ai-browser/issues",
  "keywords": [
    "tanstack-ai",
    "tanstack",
    "ai",
    "llm",
    "apple",
    "afm",
    "foundation-models",
    "apple-intelligence",
    "capacitor",
    "capacitor-plugin",
    "electron",
    "on-device",
    "local-ai"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@tanstack-ai-browser/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "src",
    "dist",
    "ios/Sources",
    "Package.swift",
    "node/build.mjs",
    "node/AfmNode.swift",
    "node/afm.c",
    "!**/*.tsbuildinfo"
  ],
  "capacitor": {
    "ios": {
      "src": "ios"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "afm"
  },
  "scripts": {
    "test": "node --import @swc-node/register/esm-register --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "node-api-headers": "1.9.0"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.0.0",
    "@tanstack/ai": "^1.2.0"
  },
  "devDependencies": {
    "@capacitor/core": "^8.6.2",
    "@tanstack/ai": "1.4.0"
  }
}
