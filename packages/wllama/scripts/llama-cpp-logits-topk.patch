+void llm_graph_context::build_logits_topk() const {
+    // only for a few outputs (decoding, speculative batches, the end of a prompt): a graph with many
+    // (the prompt reserve) reads all the logits back, and the top-k's scratch space grows with them
+    if (cparams.logits_topk == 0 || !samplers.empty() || !res->t_logits || res->t_logits->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(res->t_logits) || ggml_n_dims(res->t_logits) > 2 || res->t_logits->ne[1] == 0 ||
+        res->t_logits->ne[1] > 16 || (int64_t) cparams.logits_topk >= res->t_logits->ne[0]) {
+        return;
+    }
+    ggml_tensor *  logits = res->t_logits;
+    const int64_t  n_vocab = logits->ne[0];
+    const int64_t  n_rows  = logits->ne[1];
+    const int32_t  k       = (int32_t) cparams.logits_topk;
+    // the indices of the k largest, their values, and both as one [2k, rows] tensor (one read back);
+    // ids is an output so that its memory (with the backend's scratch space) stays its own
+    ggml_tensor * ids = ggml_top_k(ctx0, logits, k);
+    ggml_set_output(ids);
+    ggml_tensor * vals = ggml_get_rows(ctx0, ggml_reshape_3d(ctx0, logits, 1, n_vocab, n_rows), ids);
+    ggml_tensor * idsf = ggml_cast(ctx0, ids, GGML_TYPE_F32);
+    ggml_tensor * out  = ggml_concat(ctx0, ggml_reshape_2d(ctx0, vals, k, n_rows), idsf, 0);
+    ggml_set_name(out, "logits_topk");
+    ggml_set_output(out);
+    ggml_build_forward_expand(gf, out);
+    res->t_logits_topk = out;
+}
