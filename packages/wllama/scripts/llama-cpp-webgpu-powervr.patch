+            if (q4) {
+                // the lane's first word against every column, then its second
+                w << "            let xo0 = xb + (lane >> 1u) * 16u + (lane & 1u) * 4u;\n";
+                w << "            let xo1 = xb + ((lane + 4u) >> 1u) * 16u + ((lane + 4u) & 1u) * 4u;\n";
