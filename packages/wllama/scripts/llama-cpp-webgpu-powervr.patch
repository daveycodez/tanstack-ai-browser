+// in_dst: the other tensor is the ADD's output itself (computed in place).
+static ggml_tensor * ggml_webgpu_mul_mat_pvr_add_operand(webgpu_context &           ctx,
+                                                         const struct ggml_cgraph * cgraph,
+                                                         int                        node_idx,
+                                                         bool &                     in_dst) {
